#!/bin/bash
# pre-push hook: Reminder-only. Der volle Release-Flow (habits-dev dev ->
# vitalos/habit-app master -> vitalos-Pointer-Bump) läuft bereits
# automatisiert über `vos-release habits` (~/vitalos/bin/vos-release, in
# PATH). Der kritische Moment ist der Push von dev — direkt danach folgt
# sonst von Hand: Merge in vitalos/habit-app master, Push, Submodule-Pointer
# in vitalos bumpen. Deshalb hier auf "dev" triggern.
#
# Kein eigenes habits-release-Wrapperscript vorhanden (anders als bei
# fuel/fitness) — direkt `vos-release habits` nutzen.
#
# Runs once per push (not per ref), reads pushed refs from stdin.

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  if [ "${local_ref#refs/heads/}" = "dev" ]; then
    echo "💡 Tipp: für den kompletten dev->master->vitalos-Flow gibt es 'vos-release habits' (~/vitalos/bin/vos-release, vos-release --help)." >&2
    break
  fi
done

exit 0
