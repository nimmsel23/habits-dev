#!/bin/bash
# pre-push hook: Reminder-only. Der volle Release-Flow (habits-dev dev ->
# vitalos/habit-app master -> vitalos-Pointer-Bump) läuft bereits
# automatisiert über `habits-release` (~/vitalos/bin, in PATH). Der
# kritische Moment ist der Push von dev — direkt danach folgt sonst von
# Hand: Merge in vitalos/habit-app master, Push, Submodule-Pointer in
# vitalos bumpen. Deshalb hier auf "dev" triggern.
#
# Runs once per push (not per ref), reads pushed refs from stdin.

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  if [ "${local_ref#refs/heads/}" = "dev" ]; then
    echo "💡 Release: dev → master per PR mit 'vos-release-pr habits' (Check, Auto-Merge, Live per CI); master → vitalos (Shell) mit 'habits-release'. Doku: ~/vitalos/docs/DEPLOYMENT.md" >&2
    break
  fi
done

exit 0
